# Copy to .env.local for local dev. In production, set these as build variables of
# Workers Builds (Cloudflare dashboard → Worker → Settings → Build): NEXT_PUBLIC_*
# values are inlined into the client bundle at build time.
# The anon key is safe to ship in the client bundle by design — Row-Level
# Security (supabase/rls.sql) is the actual access control.
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
